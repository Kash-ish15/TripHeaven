<% layout("/layouts/boilerplate") %>

    <!-- <h1>All listings</h1>
    -->
    <style>
      #filters{
    display : flex; 
     flex-wrap: wrap;

      }
    .filter {
      text-align:center;

        margin-right: 2rem;
        margin-top:2rem;
        margin-bottom:2rem;
        opacity:0.7;

      }
      .filter:hover{
        opacity:1;
        cursor:pointer
      }
      .filter p{
        font-size:0.8rem;
      }
    </style>
<div id="filters">
  <div class="filter">
   <div> <i style="color: black" class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
     <div class="filter"><div> <i style="color: black" class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter"><div> <i style="color: black" class="fa-solid fa-mountain-sun"></i></div>
    <p>Mountains</p>
  </div>
  <div class="filter"><div> <i style="color: black" class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </div>
   <div class="filter"><div> <i style="color: black" class="fa-solid fa-snowflake"></i></div>
    <p>Arctic</p>
  </div>
     <div class="filter"><div> <i style="color: black" class="fa-solid fa-tent"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter"><div> <i style="color: black" class="fa-solid fa-tractor"></i></div>
    <p>Farms</p>
  </div>
<div class="switch filter">
  <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault" />
  <label class="form-check-label" for="switchCheckDefault">
    Display total after taxes
  </label>
  </div>
</div>
</div>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let listing of allList){ %> 
    <a class="card_a" href="/listings/<%=listing.id%>">
  <div class="card listing-card col"> 
    
  <img class="card-img-top" src= "<%= listing.image.url%>" alt="Card image cap">
   <div class="card-img-overlay">
   
  </div>

       <div class="card-body">
       <p class="card-title"><b> <%= listing.title %></b></p>
    
      <% if(listing.price){ %>
        <div style="display:flex">
<p class="card-text">
        &#8377 <%= listing.price.toLocaleString("en-IN") %>/night </p> 
        <i class="gst" style="display:none">
        &nbsp;  &nbsp;+18% gst</i>
      <% } %>
  </div>
</div>
 </div>
 </a>
 <% } %> 
</div>
<script>
   let taxSwitch = document.getElementById("switchCheckDefault");
   taxSwitch.addEventListener("click",()=>{
   let b = document.querySelectorAll(".gst");
  
   for(bt of b){
   if(bt.style.display=="none"){
    bt.style.display = "inline";
   }
   else if(bt.style.display== "inline"){
   bt.style.display = "none";
   }
  }
   })
</script>
    


